# Copy to .env and fill in local values. Never commit .env.

SKILLFORGE_DATA_DIR=data
SKILLFORGE_SQLITE_PATH=data/skillforge.db

SKILLFORGE_API_HOST=127.0.0.1
SKILLFORGE_API_PORT=8000
SKILLFORGE_CORS_ORIGINS=["http://localhost:5173"]

# fake | openai_compatible | stepfun_local | stepfun_api
SKILLFORGE_MODEL_ADAPTER=fake
SKILLFORGE_MODEL_BASE_URL=http://127.0.0.1:8080/v1
SKILLFORGE_MODEL_API_KEY=
SKILLFORGE_MODEL_NAME=step-3.7-flash
# SKILLFORGE_TRANSCRIPT_PATH=tests/fixtures/transcripts/f1-golden-openai.json

SKILLFORGE_MAX_STEPS=20
SKILLFORGE_MAX_SECONDS=120
SKILLFORGE_TEMPERATURE=0.0
# SKILLFORGE_SEED=
# SKILLFORGE_STRUCTURED_OUTPUT_MAX_RETRIES=3

# SKILLFORGE_SKILLS_GENERATED_DIR=skills/generated
# SKILLFORGE_SKILLS_PUBLISHED_DIR=skills/published

# replay | live
SKILLFORGE_DEMO_MODE=replay
SKILLFORGE_OPSLAB_PROJECT=skillforge-lab
SKILLFORGE_OPSLAB_BASE_URL=http://127.0.0.1:8088
